{
  "backend": "claude",
  "launch": {
    "arg0": "<TMP>/bin/claude",
    "argv": [
      "-p",
      "--setting-sources",
      "--strict-mcp-config",
      "--dangerously-skip-permissions",
      "--verbose",
      "--disable-slash-commands"
    ],
    "argv_nul_count": 7,
    "env": {
      "HOME": "<TMP>/home",
      "IS_SANDBOX": "1",
      "LANG": "C.UTF-8",
      "OLDPWD": "<MASKED>",
      "PATH": "<TMP>/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "PWD": "<MASKED>",
      "SHLVL": "<MASKED>",
      "SPECSTRIDE_AGENT_STREAM": "false",
      "SPECSTRIDE_EVENTS": "<TMP>/work/events.jsonl",
      "SPECSTRIDE_RUN_ID": "run-overlay-test",
      "SPECSTRIDE_STDIN_FILE": "<TMP>/tmp/specstride-prompt.XXXXXX",
      "SPECSTRIDE_TEST_CAPTURE": "<TMP>/capture",
      "SPECSTRIDE_TEST_N": "1",
      "TERM": "dumb",
      "TMPDIR": "<TMP>/tmp",
      "XDG_CACHE_HOME": "<TMP>/xdg/cache",
      "XDG_CONFIG_HOME": "<TMP>/xdg/config",
      "XDG_DATA_HOME": "<TMP>/xdg/data",
      "XDG_STATE_HOME": "<TMP>/xdg/state",
      "_": "<MASKED>"
    },
    "stdin": "standing prompt for the overlay test"
  }
}
