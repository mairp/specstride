{
  "backend": "dsh:zai/glm-5.3",
  "launch": {
    "arg0": "<TMP>/bin/dsh",
    "argv": [
      "--profile",
      "headless",
      "standing prompt for the overlay test"
    ],
    "argv_nul_count": 3,
    "env": {
      "DSH_HOME": "<TMP>/tmp/specstride-dsh-home.XXXXXX",
      "DSH_PERMISSION_MODE": "workspace-write",
      "HOME": "<TMP>/home",
      "IS_SANDBOX": "1",
      "LANG": "C.UTF-8",
      "OLDPWD": "<MASKED>",
      "PATH": "<TMP>/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "PWD": "<MASKED>",
      "SHLVL": "<MASKED>",
      "SPECSTRIDE_AGENT_STREAM": "false",
      "SPECSTRIDE_DSH_BIN": "<TMP>/bin/dsh",
      "SPECSTRIDE_DSH_MODEL": "",
      "SPECSTRIDE_DSH_PROVIDER": "",
      "SPECSTRIDE_EVENTS": "<TMP>/work/events.jsonl",
      "SPECSTRIDE_RUN_ID": "run-overlay-test",
      "SPECSTRIDE_TEST_CAPTURE": "<TMP>/capture",
      "SPECSTRIDE_TEST_N": "1",
      "TERM": "dumb",
      "TMPDIR": "<TMP>/tmp",
      "XDG_CACHE_HOME": "<TMP>/xdg/cache",
      "XDG_CONFIG_HOME": "<TMP>/xdg/config",
      "XDG_DATA_HOME": "<TMP>/xdg/data",
      "XDG_STATE_HOME": "<TMP>/xdg/state",
      "_": "<MASKED>"
    },
    "stdin": ""
  }
}
