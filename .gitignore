# Planning doc — internal only, not pushed to GitHub (per instruction).
PLAN.md

# Local Claude Code settings (host-specific permission allowlist).
.claude/settings.local.json

# Orchestrator/loop runtime state.
.specstride/
**/.specstride/
# Legacy state dir (Specstride was formerly Wiggum): still used in place by
# workdirs that predate the rename; never moved automatically.
.wiggum/
**/.wiggum/

# Generated run artifacts from example/local runs (the contract files the
# proposer/critic produce). These now live under .specstride/gates/ (already ignored
# above), so these root-level patterns are just belt-and-suspenders for anyone
# resuming a run created under the old layout. The example SPEC is committed; its
# outputs are not.
GATE*-EVIDENCE.md
GATE*-APPROVED
GATE*-FEEDBACK.md
PROGRESS.md

# Secrets / env.
.env
*.env

# Optional telemetry volumes (Loki/Grafana data live in named docker volumes,
# but ignore any bind-mount dirs a user might add).
telemetry/volumes/
telemetry/data/

# Python bytecode.
__pycache__/
*.pyc

# pytest cache (test tooling only; the runtime needs no venv/pip).
.pytest_cache/

# stray test-run artifact (accidental gitlink)
.specstride-autonomy-smoke
.wiggum-autonomy-smoke

# ── One-off operational artifacts ─────────────────────────────────────────────
# Scripts and records produced while *operating* Specstride on a particular run
# or another repo (ainetops, semantic-router-sovereign). They hardcode paths,
# features and model choices from that one run, so they are working state, not
# source. Kept on disk, out of the repo.
resume-001.sh
swap-002-proposer-to-gpt5.sh
merge-main-into-002.sh
merge-002-into-main.sh
untrack-specs-wiggum.sh
tls-chain-inspect.sh
roadmap/prompts/check-run-complete.sh
roadmap/prompts/rename-wiggum-to-specstride.md
.codex-phase13-spec.patch

# Recorded loop state and postmortems from individual historical runs.
.ralph/
INCIDENT-*.md
crash_incident

# Launcher scripts for the completed 001 feature (its Spec Kit record stays).
specs/*/run-ralph.sh
specs/*/check-done.sh

# Local working folders: planning notes, reverse-engineered specs, feature specs.
roadmap/
reversed/
specs/
