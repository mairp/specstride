#!/usr/bin/env bash
# specstride — the single front door for a Specstride run: start it, then inspect it.
#
#   specstride run       [-w DIR] [-s SPEC] […]  START a run (→ orchestrator.sh).
#                                        `specstride -w DIR …` (leading flag) also starts.
#                                        Pass --help after `run` for all launch flags.
#   specstride status    [-w DIR] [--feature S] [--all]  one-screen state (run state,
#                                        phases, files). Also shows the active capture
#                                        mode (structured/raw-text/degraded + reason)
#                                        and telemetry receiver state (configured/
#                                        reachable/request-accepted/query-verified).
#                                        --all lists every feature.
#   specstride watch     [-w DIR]            live status card (mini-TUI; Ctrl-C detaches)
#   specstride tail      [-w DIR] [--feature S]  tail -f the orchestrator run.log
#   specstride events    [-w DIR] [--feature S] [-f] [--json]  the raw event stream:
#                                        every milestone + agent tool call/message
#   specstride verdicts  [-w DIR] [--feature S] [N]  dump critic reply(ies)
#   specstride feedback   <N> [-w DIR] [--feature S]  show GATE<N>-FEEDBACK.md
#   specstride phases    [-w DIR] [-s SPEC] [--feature S]  list phases + per-phase state
#   specstride stop      [-w DIR] [--now]    request a clean stop (MUTATES: writes
#                                        stop.flag; --now also kills the in-flight
#                                        agent pass). Rerun/resume picks up after.
#   specstride resume    [-w DIR] [--feature S] [overrides…]  relaunch the orchestrator
#                                        from the saved config of the last run.
#   specstride learn     [-w DIR] [--feature S] [--show|--apply|--revert <run-id>|--off|--summarize|--evaluate]
#                                        the self-tuning loop (roadmap/research/
#                                        self-improvement-loops/02-wiggum-loop-design.md
#                                        §5): --show (default) prints suggested knob
#                                        values, changing nothing; --apply writes a
#                                        decision (MUTATES: learning/applied.json +
#                                        a knob_adjusted event); --revert <run-id>
#                                        undoes one; --off reverts everything. A
#                                        decision only takes effect at run time under
#                                        SPECSTRIDE_LEARNING=apply. --summarize prints
#                                        the metric JSON and --evaluate what evaluate
#                                        would conclude now; both read-only.
# Launch defaults to required verification with feature-scoped TEST_PLAN.md and
# generated scaffolds; `--verification plan|off` changes that behavior. Explicit
# `--test-plan`/`--generate-tests` paths override defaults, and resume preserves
# resolved settings unless explicitly overridden.
#
# All other subcommands are read-only. -w points at the project workdir (default:
# $PWD); -s at its spec file (default: <workdir>/SPECS.md). --feature SLUG selects a
# feature namespace under .specstride/features/ (default: the last run's feature). See
# orchestrator.sh --help for launch flags.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"          # Python components live here
# shellcheck source=/dev/null
. "$SCRIPT_DIR/specstride-lib.sh"

usage() {
  sed -n '2,43p' "$0" | sed 's/^# \{0,1\}//'
}

# ── Single front door ──────────────────────────────────────────────────────
# Starting a run and inspecting it are the SAME command. This script is the one
# source of truth for that routing (a shell rc should only point at it, never
# re-implement the dispatch):
#   • `specstride run …` / `specstride start …`      → start a run (orchestrator.sh)
#   • `specstride -w DIR -s SPEC …`  (leading flag) → start a run (orchestrator.sh)
#   • `specstride <verb> …` (status/watch/…) and `-h`/`--help` → inspect, below.
SUB="${1:-}"
case "$SUB" in
  run|start)          shift; exec bash "$SCRIPT_DIR/orchestrator.sh" "$@" ;;
  -h|--help|help|"")  ;;                                   # → inspection usage
  -*)                 exec bash "$SCRIPT_DIR/orchestrator.sh" "$@" ;;  # bare flag → launch
esac

# parse: subcommand, optional -w DIR / -s SPEC, flags, and pass-through extras
shift || true
LAUNCH_DIR="$PWD"
WORKDIR="$PWD"
SPECS=""
SPECS_EXPLICIT=""
FEATURE=""
ALL="false"
FOLLOW="false"
JSON_OUT="false"
NOW="false"
EXTRA=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -w|--workdir) WORKDIR="${2:?}"; shift 2 ;;
    -s|--specs)   SPECS="${2:?}"; SPECS_EXPLICIT="true"; shift 2 ;;
    --feature)    FEATURE="${2:?}"; shift 2 ;;
    --all)        ALL="true"; shift ;;
    -f|--follow)  FOLLOW="true"; shift ;;
    --json)       JSON_OUT="true"; shift ;;
    --now)        NOW="true"; shift ;;
    -h|--help)    usage; exit 0 ;;
    *)            EXTRA+=("$1"); shift ;;
  esac
done
POS="${EXTRA[0]:-}"

# Resolve a relative -s against the launch dir (before we lose it), same rule as
# orchestrator.sh, so `specstride status -s ./ROADMAP.md` works from anywhere.
if [[ -n "$SPECS" ]]; then
  case "$SPECS" in /*) : ;; *) SPECS="$LAUNCH_DIR/$SPECS" ;; esac
fi
WORKDIR="$(cd "$WORKDIR" 2>/dev/null && pwd || echo "$WORKDIR")"
specstride_resolve_state_dir "$WORKDIR"   # STATE_BASENAME: .specstride, or a legacy dir
STATE_DIR="$WORKDIR/$STATE_BASENAME"
SPECS="${SPECS:-$WORKDIR/SPECS.md}"

# ── resolve the active feature namespace (Phase 3) ───────────────────────────
# Durable state is per-feature under .specstride/features/<slug>/. Selection order:
#   1. --feature SLUG               (explicit; sanitized).
#   2. FEATURE= in root last-run.conf  (the feature the last run used — the default
#      so bare `specstride status`/`resume` mean "the feature I last ran").
#   3. "default"                    (native/back-compat).
sanitize_slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//'; }
SLUG=""
if [[ -n "$FEATURE" ]]; then
  SLUG="$(sanitize_slug "$FEATURE")"
elif [[ -f "$STATE_DIR/last-run.conf" ]]; then
  SLUG="$(grep -m1 '^FEATURE=' "$STATE_DIR/last-run.conf" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
fi
[[ -n "$SLUG" ]] || SLUG="default"
FEATURE_DIR="$STATE_DIR/features/$SLUG"
# All gate files live in the feature's gates/ (out of the project root); PROGRESS.md
# lives directly under the feature dir.
GATES_DIR="$FEATURE_DIR/gates"

# Resolve the spec for read-only subcommands: an explicit -s wins; else the feature's
# saved SPECS= (a speckit feature has no SPECS.md); else the native SPECS.md default.
if [[ -z "${SPECS_EXPLICIT:-}" && ! -f "$SPECS" && -f "$FEATURE_DIR/last-run.conf" ]]; then
  _fs="$(grep -m1 '^SPECS=' "$FEATURE_DIR/last-run.conf" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
  [[ -n "$_fs" && -f "$_fs" ]] && SPECS="$_fs"
fi

need_state() {
  [[ -d "$STATE_DIR" ]] || { echo "no $STATE_DIRNAME/ state dir in $WORKDIR" >&2; exit 1; }
  [[ "$ALL" == "true" || -d "$FEATURE_DIR" ]] || {
    echo "no feature '$SLUG' in $WORKDIR ($STATE_BASENAME/features/$SLUG missing)." >&2
    if [[ -d "$STATE_DIR/features" ]]; then
      echo "known features:" >&2
      for d in "$STATE_DIR/features"/*/; do [[ -d "$d" ]] && echo "  - $(basename "$d")" >&2; done
    fi
    exit 1
  }
}

# True when an orchestrator currently holds the run lock on this workdir.
lock_held() {
  if command -v flock >/dev/null 2>&1; then
    [[ -e "$STATE_DIR/lock" ]] || return 1
    ! flock -n "$STATE_DIR/lock" -c true 2>/dev/null
  else
    [[ -d "$STATE_DIR/lock.d" ]]
  fi
}

# TERM a process and all its descendants (used by `stop --now`).
kill_tree() {
  local p
  for p in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$p"; done
  kill -TERM "$1" 2>/dev/null || true
}

# Resolve the events.jsonl / run.log for the ACTIVE feature. The .specstride/ root
# symlinks track the LAST run (any feature); when a specific --feature is asked for,
# read that feature's own newest run instead so status/tail/events are feature-true.
feature_events() {
  if [[ -n "$FEATURE" ]]; then
    ls -1t "$FEATURE_DIR"/runs/*/events.jsonl 2>/dev/null | head -1
  else
    echo "$STATE_DIR/events.jsonl"
  fi
}
feature_runlog() {
  if [[ -n "$FEATURE" ]]; then
    ls -1t "$FEATURE_DIR"/runs/*/run.log 2>/dev/null | head -1
  else
    echo "$STATE_DIR/run.log"
  fi
}

# `specstride status --all`: one row per feature with approved/total phase counts.
status_all() {
  need_state
  echo "specstride status --all — $WORKDIR"
  if [[ ! -d "$STATE_DIR/features" ]]; then echo "  (no features yet)"; return; fi
  printf "  %-32s %-10s %s\n" "FEATURE" "PHASES" "STATE"
  printf "  %-32s %-10s %s\n" "--------------------------------" "----------" "-----"
  for d in "$STATE_DIR/features"/*/; do
    [[ -d "$d" ]] || continue
    local slug ev approved total state
    slug="$(basename "$d")"
    # Count APPROVED gates and total phases (total needs the spec — from that
    # feature's last-run.conf if present, else just show approved count).
    approved="$(ls "$d/gates"/GATE*-APPROVED 2>/dev/null | wc -l | tr -d ' ')"
    total="?"
    if [[ -f "$d/last-run.conf" ]]; then
      local fspecs
      fspecs="$(grep -m1 '^SPECS=' "$d/last-run.conf" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
      [[ -f "$fspecs" ]] && total="$(SPECSTRIDE_SPEC_FORMAT='' specstride_spec_validate "$fspecs" 2>/dev/null || echo '?')"
    fi
    # state headline from that feature's newest events.jsonl
    ev="$(ls -1t "$d"/runs/*/events.jsonl 2>/dev/null | head -1)"
    state="—"
    if [[ -n "$ev" && -f "$ev" ]]; then
      state="$(python3 - "$ev" <<'PYEOF'
import json,sys
last=None
try:
  for line in open(sys.argv[1]):
    try:o=json.loads(line)
    except ValueError:continue
    if o.get("event") in ("run_stop","run_end"):last=o
except OSError:pass
if last is None:print("running/crashed")
elif last["event"]=="run_end":print("DONE:%s"%last.get("outcome","?"))
else:print("HALTED:%s@%s"%(last.get("reason","?"),last.get("phase","?")))
PYEOF
)"
    fi
    printf "  %-32s %-10s %s\n" "$slug" "${approved}/${total}" "$state"
  done
}

case "$SUB" in
  status)
    if [[ "$ALL" == "true" ]]; then status_all; exit 0; fi
    need_state
    echo "specstride status — $WORKDIR  (feature: $SLUG)"
    # run-state headline: RUNNING / STOPPED / HALTED / DONE
    STATUS_EV="$(feature_events)"
    if lock_held; then
      owner="$(head -c 200 "$STATE_DIR/lock" 2>/dev/null | head -1)"
      echo "  state: RUNNING${owner:+ ($owner)}"
    elif [[ -n "$STATUS_EV" && -f "$STATUS_EV" ]]; then
      python3 - "$STATUS_EV" <<'PYEOF'
import json, sys
last = None
try:
    for line in open(sys.argv[1]):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("event") in ("run_stop", "run_end"):
            last = o
except OSError:
    pass
if last is None:
    print("  state: not running (no clean end recorded — crashed or never finished a run)")
elif last["event"] == "run_end":
    print("  state: DONE — %s" % last.get("outcome", "?"))
else:
    r, ph = last.get("reason", "?"), last.get("phase", "?")
    if r == "stop_flag":
        print("  state: STOPPED at phase %s — resume with: specstride resume" % ph)
    elif r == "max_rejects":
        print("  state: HALTED at phase %s — needs human (max-rejects exceeded)" % ph)
    elif r in ("proposer_yield_budget", "proposer_yield_timeout"):
        # A pass ended cleanly and declared what it was waiting on; the WAIT ran
        # out, not the agent. The job was left alone, so say where to look.
        print("  state: HALTED at phase %s — a declared yield's wait ran out "
              "(deadline, wall budget, or too many yields in one attempt). The job was "
              "left running, not killed: read its log under .specstride/features/*/yield-jobs/" % ph)
    elif r == "proposer_cap_exhausted":
        # Distinct from proposer_consecutive_errors on purpose: nothing failed,
        # the work did not fit the pass. Naming the wrong remedy here is how a
        # project ends up with its error breaker disabled.
        print("  state: HALTED at phase %s — the phase's work does not fit one pass "
              "(consecutive hard_cap kills). Make the long step outlive the pass "
              "(--long-job-cmd) or split the phase; raising the cap is the last resort" % ph)
    else:
        print("  state: HALTED at phase %s — %s" % (ph, r))
PYEOF
    else
      echo "  state: no run recorded yet"
    fi
    if [[ -f "$SPECS" ]]; then
      echo
      printf "  %-6s %-28s %-8s %-8s %-8s\n" "PHASE" "TITLE" "EVIDENCE" "APPROVED" "FEEDBACK"
      printf "  %-6s %-28s %-8s %-8s %-8s\n" "-----" "----------------------------" "--------" "--------" "--------"
      while read -r n; do
        [[ -z "$n" ]] && continue
        title="$(specstride_spec_phase_title "$SPECS" "$n")"
        ev="✗"; [[ -f "$GATES_DIR/GATE${n}-EVIDENCE.md" ]] && ev="✓"
        ap="✗"; [[ -f "$GATES_DIR/GATE${n}-APPROVED" ]] && ap="✓"
        fb="✗"; [[ -f "$GATES_DIR/GATE${n}-FEEDBACK.md" ]] && fb="✓"
        printf "  %-6s %-28.28s %-8s %-8s %-8s\n" "$n" "$title" "$ev" "$ap" "$fb"
      done < <(specstride_spec_phase_numbers "$SPECS")
      cur="$(specstride_spec_first_unapproved "$SPECS" "$WORKDIR" "$GATES_DIR")"
      echo
      echo "  current phase: ${cur:-<all approved>}"
    else
      echo "  (no SPECS.md found)"
    fi
    # Telemetry receiver states (FR-036): distinguish configured / reachable /
    # request-accepted / query-verified — never a collapsed "telemetry: true".
    # Config comes from the feature's last-run.conf; runtime evidence in the
    # events.jsonl can elevate the claim beyond a probe.
    _tconf=""
    [[ -f "$FEATURE_DIR/last-run.conf" ]] && _tconf="$FEATURE_DIR/last-run.conf"
    [[ -z "$_tconf" && -f "$STATE_DIR/last-run.conf" ]] && _tconf="$STATE_DIR/last-run.conf"
    if [[ -n "$_tconf" ]]; then
      _tel="$(grep -m1 '^TELEMETRY=' "$_tconf" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
      _otel="$(grep -m1 '^OTEL=' "$_tconf" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
      _lokiurl="$(grep -m1 '^LOKI_URL=' "$_tconf" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
      _otelurl="$(grep -m1 '^OTEL_URL=' "$_tconf" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
      if [[ "$_tel" == "true" || "$_otel" == "true" ]]; then
        echo
        echo "  telemetry:"
        [[ "$_tel" == "true" ]]  && echo "    $(specstride_telemetry_status_line loki "${_lokiurl:-http://localhost:3100}" "$STATUS_EV")"
        [[ "$_otel" == "true" ]] && echo "    $(specstride_telemetry_status_line otel "${_otelurl:-http://localhost:4318}" "$STATUS_EV")"
      fi
    fi
    # Per-invocation observability state (T062 / SC-012): the active capability
    # mode, its stable degradation reason, and the latest tool activity are
    # explicit labeled fields — not left buried in the agent_* stream a reader
    # would otherwise have to grep the source for.
    if [[ -n "$STATUS_EV" && -f "$STATUS_EV" ]]; then
      tail -n 400 "$STATUS_EV" 2>/dev/null | python3 -c '
import sys, json
obs = tool = None
for line in sys.stdin:
    try: o = json.loads(line)
    except Exception: continue
    e = o.get("event", "")
    if e == "agent_observability":
        obs = o
    elif e == "agent_tool":
        tool = o
if obs is not None:
    print("  observability: %s%s" % (
        obs.get("mode", "?"),
        (" — %s" % obs["reason"]) if obs.get("reason") else ""))
if tool is not None:
    summ = tool.get("summary") or tool.get("status") or ""
    print("  latest tool: %s%s" % (
        tool.get("tool", "?"), (" (%s)" % summ) if summ else ""))
' 2>/dev/null || true
    fi
    # last milestones from events (high-frequency agent_* noise filtered out)
    if [[ -n "$STATUS_EV" && -f "$STATUS_EV" ]]; then
      echo "  last events:"
      tail -n 200 "$STATUS_EV" 2>/dev/null | python3 -c '
import sys, json
keep = []
for line in sys.stdin:
    try: o=json.loads(line)
    except Exception: continue
    if o.get("event","").startswith(("agent_","iter_")): continue
    keep.append(o)
for o in keep[-5:]:
    print("    %s  %s  %s" % (o.get("time","")[-8:] if o.get("time") else "",
        o.get("event",""), " ".join("%s=%s"%(k,v) for k,v in o.items()
        if k not in ("time","ts","event","task","backend","run_id"))))
' 2>/dev/null || true
    fi
    ;;

  tail)
    need_state
    LOG="$(feature_runlog)"
    [[ -n "$LOG" && -f "$LOG" ]] || { echo "no run.log yet for feature '$SLUG' in $STATE_DIR" >&2; exit 1; }
    exec tail -f "$LOG"
    ;;

  events)
    need_state
    EV="$(feature_events)"
    [[ -n "$EV" ]] || EV="$STATE_DIR/events.jsonl"
    [[ -e "$EV" ]] || { echo "no events.jsonl yet in $STATE_DIR" >&2; exit 1; }
    args=( --events "$EV" )
    [[ "$FOLLOW" == "true" ]] && args+=( --follow )
    if [[ "$JSON_OUT" == "true" ]]; then
      exec python3 "$LIB_DIR/present.py" "${args[@]}" --quiet
    fi
    exec python3 "$LIB_DIR/present.py" "${args[@]}" --mode plain
    ;;

  verdicts)
    need_state
    VD="$FEATURE_DIR/verdicts"
    [[ -d "$VD" ]] || { echo "no verdicts recorded yet ($VD)" >&2; exit 1; }
    if [[ -n "$POS" ]]; then
      shopt -s nullglob
      files=("$VD/phase${POS}."*.txt)
      shopt -u nullglob
      [[ ${#files[@]} -gt 0 ]] || { echo "no verdicts for phase $POS" >&2; exit 1; }
    else
      shopt -s nullglob
      files=("$VD"/*.txt)
      shopt -u nullglob
    fi
    for f in "${files[@]}"; do
      echo "════════════════════════════════════════════════════════════════"
      echo "# $f"
      echo "════════════════════════════════════════════════════════════════"
      cat "$f"
      echo
    done
    ;;

  feedback)
    [[ -n "$POS" ]] || { echo "usage: specstride feedback <N> [-w DIR]" >&2; exit 1; }
    FB="$GATES_DIR/GATE${POS}-FEEDBACK.md"
    [[ -f "$FB" ]] || { echo "no feedback for phase $POS ($FB)" >&2; exit 1; }
    cat "$FB"
    ;;

  watch)
    need_state
    exec python3 "$LIB_DIR/present.py" --workdir "$WORKDIR" --mode card
    ;;

  phases)
    [[ -f "$SPECS" ]] || { echo "no SPECS.md in $WORKDIR" >&2; exit 1; }
    if ! cnt="$(specstride_spec_validate "$SPECS" 2>/tmp/specstride-spec-err)"; then
      echo "SPEC INVALID:"; cat /tmp/specstride-spec-err; rm -f /tmp/specstride-spec-err; exit 3
    fi
    rm -f /tmp/specstride-spec-err
    echo "$SPECS — $cnt phase(s):"
    while read -r n; do
      [[ -z "$n" ]] && continue
      title="$(specstride_spec_phase_title "$SPECS" "$n")"
      state="pending"
      [[ -f "$GATES_DIR/GATE${n}-EVIDENCE.md" ]] && state="evidence-written"
      [[ -f "$GATES_DIR/GATE${n}-FEEDBACK.md" ]] && state="rejected(has-feedback)"
      [[ -f "$GATES_DIR/GATE${n}-APPROVED" ]] && state="APPROVED"
      printf "  Phase %-3s %-40.40s [%s]\n" "$n" "$title" "$state"
    done < <(specstride_spec_phase_numbers "$SPECS")
    ;;

  stop)
    need_state
    if ! lock_held; then
      echo "specstride stop: no run appears to be active on $WORKDIR (lock is free)." >&2
      echo "             writing stop.flag anyway (a starting run will honor it)." >&2
    fi
    touch "$STATE_DIR/stop.flag"
    echo "stop requested → $STATE_DIR/stop.flag"
    if [[ "$NOW" == "true" ]]; then
      PIDF="$STATE_DIR/proposer.pid"
      if [[ -f "$PIDF" ]]; then
        pid="$(cat "$PIDF" 2>/dev/null)"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
          kill_tree "$pid"
          echo "killed in-flight agent pass (pid $pid + descendants)"
        else
          echo "recorded pass (pid ${pid:-?}) is not running — nothing to kill"
        fi
      else
        echo "no in-flight pass recorded ($PIDF missing) — flag-only stop"
      fi
      echo "the run will exit 6 (clean stop) momentarily; resume with: specstride resume -w $WORKDIR"
    else
      echo "the run finishes its current pass, then exits 6 (clean stop)."
      echo "resume later with: specstride resume -w $WORKDIR   (or stop harder: specstride stop --now)"
    fi
    ;;

  resume)
    need_state
    # Bare `specstride resume` → the root last-run.conf (the feature the last run used).
    # `specstride resume --feature X` → X's own saved config, preserving its SPEC_FORMAT.
    if [[ -n "$FEATURE" ]]; then
      CONF="$FEATURE_DIR/last-run.conf"
      [[ -f "$CONF" ]] || { echo "specstride resume: no last-run config for feature '$SLUG' ($CONF)." >&2; exit 1; }
    else
      CONF="$STATE_DIR/last-run.conf"
      [[ -f "$CONF" ]] || { echo "specstride resume: no $CONF — launch the run once via orchestrator.sh first." >&2; exit 1; }
    fi
    if lock_held; then
      echo "specstride resume: a run is already ACTIVE on $WORKDIR (lock held) — nothing to resume." >&2
      exit 1
    fi
    # shellcheck source=/dev/null
    . "$CONF"
    [[ -n "${ORCHESTRATOR:-}" && -f "$ORCHESTRATOR" ]] || ORCHESTRATOR="$SCRIPT_DIR/orchestrator.sh"
    args=( -w "$WORKDIR" -s "$SPECS"
           --proposer "$PROPOSER_BACKEND" --critic "$CRITIC_BACKEND"
           --max-rejects "$MAX_REJECTS" --max-iter "$MAX_ITER" )
    # Preserve the feature namespace across resume (older confs won't have it).
    [[ -n "${FEATURE:-}" ]] && args+=( --feature "$FEATURE" )
    # Preserve the spec format across resume (older confs won't have it — auto-detect).
    [[ -n "${SPEC_FORMAT:-}" ]] && args+=( --spec-format "$SPEC_FORMAT" )
    [[ -n "${VERIFICATION:-}" ]] && args+=( --verification "$VERIFICATION" )
    [[ -n "${TEST_PLAN:-}" ]] && args+=( --test-plan "$TEST_PLAN" )
    # Without this a resume re-plans from the discovered heuristic alone and every
    # later gate quietly narrows to it (older confs won't carry the key).
    [[ -n "${VERIFICATION_COMMANDS:-}" ]] && args+=( --verification-commands "$VERIFICATION_COMMANDS" )
    [[ -n "${GENERATE_TESTS:-}" ]] && args+=( --generate-tests "$GENERATE_TESTS" )
    # The pass ceiling and its per-phase overrides (older confs won't carry
    # either): a resume that drops them runs each phase under a different budget
    # than the one it was planned for, silently reverting to the 1800s default.
    [[ -n "${PROPOSER_TIMEOUT:-}" ]] && args+=( --proposer-timeout "$PROPOSER_TIMEOUT" )
    for _pt in ${PROPOSER_TIMEOUT_PHASES:-}; do
      args+=( --proposer-timeout-phase "$_pt" )
    done
    [[ "${TELEMETRY:-false}" == "true" ]] && args+=( --telemetry --loki-url "$LOKI_URL" )
    [[ "${OTEL:-false}" == "true" ]] && args+=( --otel --otel-url "$OTEL_URL" )
    # A phase's long-running verification job must survive resume (older confs
    # won't carry it); without this the resumed run never launches the job the
    # phase's evidence depends on.
    [[ -n "${LONG_JOB_PHASE:-}" && -n "${LONG_JOB_CMD:-}" ]] && \
      args+=( --long-job-phase "$LONG_JOB_PHASE" --long-job-cmd "$LONG_JOB_CMD" )
    # Git checkpoints are env-only, so the saved value travels as the env var
    # (older confs won't carry it; the caller's env and .env then decide, as today).
    [[ -n "${GIT_COMMITS:-}" ]] && export SPECSTRIDE_GIT_COMMITS="$GIT_COMMITS"
    # anything extra passed to `specstride resume` overrides the saved config
    # (orchestrator parses flags last-wins).
    args+=( "${EXTRA[@]}" )
    echo "resuming: $ORCHESTRATOR ${args[*]}"
    exec bash "$ORCHESTRATOR" "${args[@]}"
    ;;

  learn)
    # `specstride learn` is a thin dispatcher onto lib/learn.py (design
    # roadmap/research/self-improvement-loops/02-wiggum-loop-design.md §5/§6 step 5).
    # It is read/decision-only here: it never touches a run in progress, and the
    # ONLY thing that makes a decision it writes take effect at run time is the
    # SPECSTRIDE_LEARNING=apply environment variable a later `specstride run`/`resume`
    # is launched with (lib/learn.py's own `resolve` is the integration point).
    need_state
    MODE="${EXTRA[0]:---show}"
    PASSTHRU=("${EXTRA[@]:1}")
    # Every run of the feature, as the run's own observe/evaluate hooks read it —
    # not only the newest run's stream (feature_events): the 3-sample floor is a
    # cross-run count. Falls back to the newest stream for an old flat layout.
    if [[ -d "$FEATURE_DIR/runs" ]]; then EV="$FEATURE_DIR/runs"; else EV="$(feature_events)"; fi
    args=( --feature-dir "$FEATURE_DIR" )
    # Key every phase on its current shape (lib/specstride_spec.py), so samples and
    # decisions of an edited phase are left out, exactly as a run leaves them out.
    shape_args=()
    if [[ -f "$SPECS" ]]; then
      shape_args=( --specs "$SPECS" )
      _sf="$(grep -m1 '^SPEC_FORMAT=' "$FEATURE_DIR/last-run.conf" 2>/dev/null | cut -d= -f2- | tr -d "'\"")"
      [[ -n "${_sf:-}" ]] && shape_args+=( --spec-format "$_sf" )
    fi
    # `advise`/`apply` need --default, and it must be the default of the knob asked
    # about: the engines step ±50 % from it, so a 1800 s default handed to the 30 s
    # poll interval would let one apply jump it to its 300 s bound. Fall back to the
    # same resolution the run uses: `SPECSTRIDE_PROPOSER_TIMEOUT` else 1800 for
    # `proposer_timeout` (orchestrator.sh:195), `SPECSTRIDE_YIELD_POLL` else 30 for
    # `yield_poll_interval` (proposer.sh). `revert`/`off` take no --default, so this
    # is only injected for the two modes that use it.
    add_default() {
      local a knob="proposer_timeout" prev=""
      for a in "${PASSTHRU[@]:-}"; do
        [[ "$a" == "--default" || "$a" == --default=* ]] && return
        [[ "$prev" == "--knob" ]] && knob="$a"
        [[ "$a" == --knob=* ]] && knob="${a#--knob=}"
        prev="$a"
      done
      case "$knob" in
        yield_poll_interval) PASSTHRU+=( --default "${SPECSTRIDE_YIELD_POLL:-30}" ) ;;
        *)                   PASSTHRU+=( --default "${SPECSTRIDE_PROPOSER_TIMEOUT:-1800}" ) ;;
      esac
    }
    case "$MODE" in
      --show)
        add_default
        [[ -n "$EV" && -e "$EV" ]] && args+=( --events "$EV" )
        rc=0
        python3 "$LIB_DIR/learn.py" advise "${args[@]}" "${shape_args[@]}" "${PASSTHRU[@]}" || rc=$?
        # ... then where each applied decision stands: its latest evaluation, read-only
        python3 "$LIB_DIR/learn.py" evaluate --report --feature-dir "$FEATURE_DIR" || true
        exit "$rc"
        ;;
      --apply)
        add_default
        [[ -n "$EV" && -e "$EV" ]] && args+=( --events "$EV" )
        exec python3 "$LIB_DIR/learn.py" apply "${args[@]}" "${shape_args[@]}" "${PASSTHRU[@]}"
        ;;
      --summarize)
        # read-only: the §5.3 metric set over every run of the feature, as JSON
        exec python3 "$LIB_DIR/learn.py" summarize --events "$EV" "${PASSTHRU[@]}"
        ;;
      --evaluate)
        # read-only: what evaluate would conclude now; --dry-run writes no entry,
        # emits no event and reverts nothing
        exec python3 "$LIB_DIR/learn.py" evaluate --dry-run --events "$EV" "${args[@]}" \
          "${shape_args[@]}" "${PASSTHRU[@]}"
        ;;
      --revert)
        [[ ${#PASSTHRU[@]} -ge 1 ]] || { echo "usage: specstride learn --revert <run-id>" >&2; exit 1; }
        exec python3 "$LIB_DIR/learn.py" revert "${PASSTHRU[0]}" --feature-dir "$FEATURE_DIR" "${PASSTHRU[@]:1}"
        ;;
      --off)
        exec python3 "$LIB_DIR/learn.py" off --feature-dir "$FEATURE_DIR" "${PASSTHRU[@]}"
        ;;
      *)
        echo "specstride learn: unknown option '$MODE' (expected --show|--apply|--revert <run-id>|--off|--summarize|--evaluate)" >&2
        exit 1
        ;;
    esac
    ;;

  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "specstride: unknown subcommand '$SUB'" >&2
    usage >&2
    exit 1
    ;;
esac
